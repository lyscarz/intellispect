# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-only, never exposed to client

OPENAI_API_KEY=
# Optional:
# OPENAI_MODEL=gpt-4o

# ─── Telematics credential encryption ─────────────────────────────────────────
# 32-byte base64 key. Generate with: openssl rand -base64 32
TELEMATICS_ENC_KEY=replace_with_base64_32_bytes

# ─── Cron authentication ──────────────────────────────────────────────────────
# Random secret. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/refresh-aemp every 30 min (see vercel.json). Generate with:
#   openssl rand -hex 32
CRON_SECRET=replace_with_random_hex_32_bytes

# ─── Trackunit API credentials (LEGACY — only used by /trackunit-debug) ──────
# In the new flow, Trackunit credentials are stored per-account in Supabase
# (entered via /settings/connections). These env vars only power the legacy
# debug view at /trackunit-debug and will be removed once that page is deleted.
#
# OAuth 2.0 client credentials (machine-to-machine — no user login required)
TRACKUNIT_CLIENT_ID=your_client_id_here
TRACKUNIT_CLIENT_SECRET=your_client_secret_here
# Password-grant user (for REST endpoints)
TRACKUNIT_API_USERNAME=
TRACKUNIT_API_PASSWORD=

# Trackunit OAuth token endpoint
TRACKUNIT_TOKEN_URL=https://auth.trackunit.com/token

# Trackunit GraphQL endpoint (usually doesn't change).
# IMPORTANT: trailing slash is required — without it the gateway routes to the
# Trackunit Manager SPA and you get a 404 HTML page instead of GraphQL.
TRACKUNIT_API_URL=https://iris.trackunit.com/api/graphql/

# Optional V2 client_credentials for IrisX GraphQL (asset.view scope) — images
TRACKUNIT_GQL_CLIENT_ID=
TRACKUNIT_GQL_CLIENT_SECRET=
