# Same Supabase project as the desktop app, so logins match.
# Copy these from the desktop app's .env.local (NEXT_PUBLIC_SUPABASE_*).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Desktop Next.js origin that serves the AI inspection API routes
# (used only by the AI/intent inspection flow).
VITE_INSPECTIONS_API_BASE=http://localhost:3000
